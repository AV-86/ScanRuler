# SPDX-License-Identifier: AGPL-3.0-only
FROM node:22-alpine

RUN apk add --no-cache socat

WORKDIR /opt/scanruler-mcp

COPY mcp/package.json mcp/package-lock.json ./
RUN npm ci --omit=dev && npm install -g supergateway@4.2.1

COPY mcp/bin ./bin
COPY mcp/src ./src
COPY docker/mcp-entrypoint.sh docker/mcp-http-entrypoint.sh /usr/local/bin/
RUN sed -i 's/\r$//' /usr/local/bin/mcp-entrypoint.sh /usr/local/bin/mcp-http-entrypoint.sh \
  && chmod +x /usr/local/bin/mcp-entrypoint.sh /usr/local/bin/mcp-http-entrypoint.sh

ENV SCANRULER_MCP_CONFIG_DIR=/config \
    SCANRULER_MCP_NO_UPDATE=1

ENTRYPOINT ["/usr/local/bin/mcp-entrypoint.sh"]
